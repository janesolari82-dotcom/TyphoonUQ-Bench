# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Raw / processed data (kept out of GitHub; release via Zenodo)
data/raw/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Training outputs (re-generated locally; reference results live in `results/`)
outputs/
!outputs/.gitkeep

# Logs and run artefacts
logs/
*.log
*.out
*.err

# Ascend / NPU specific
kernel_meta/
fusion_result.json
ge_check_op.json

# Local secrets / personal scratch
secrets.yaml
.env
scratch/
tmp/
temp/

# Large binary artefacts that should be regenerated, not committed
*.pt
*.ckpt
*.h5
*.parquet
!docs/**/*.parquet
!examples/**/*.parquet
